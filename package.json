{
  "name": "@synapxlab/multiselect",
  "version": "0.1.0",
  "description": "Multi-select with chips, search and a listbox popup — vanilla TypeScript, zero dependency, progressive enhancement of a native <select>.",
  "type": "module",
  "main": "./dist/multiselect.umd.cjs",
  "module": "./dist/multiselect.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/multiselect.es.js",
      "require": "./dist/multiselect.umd.cjs"
    },
    "./style": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build --config vite.lib.config.ts && npm run minify:es && tsc -p tsconfig.build.json",
    "minify:es": "esbuild dist/multiselect.es.js --minify --sourcemap --allow-overwrite --outfile=dist/multiselect.es.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "keywords": [
    "multiselect",
    "multi-select",
    "select",
    "chips",
    "tags",
    "combobox",
    "listbox",
    "select2",
    "typescript",
    "vanilla",
    "zero-dependency",
    "accessible"
  ],
  "author": "synapxLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synapxLab/multiselect"
  },
  "bugs": {
    "url": "https://github.com/synapxLab/multiselect/issues"
  },
  "homepage": "https://github.com/synapxLab/multiselect#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0",
    "sass": "^1.90.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
